<!DOCTYPE html>
<html>
<head>
    <title>Department Home</title>
    <style>
        body {
            /* Changed background from light blue to soft light green */
            background-color: #f0f7f4; 
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        header {
            /* Changed header from blue to forest green */
            background-color: #2e7d32; 
            color: white;
            padding: 20px;
            text-align: center;
        }
        header h1 {
            margin: 0;
            font-size: 26px;
        }
        header p {
            margin: 5px 0 0;
            font-size: 14px;
        }
        .content {
            max-width: 500px;
            margin: 30px auto;
            background-color: white;
            padding: 25px;
            border-radius: 8px;
            border: 1px solid #ddd;
            text-align: center;
        }
        .content h2 {
            /* Changed department title text from blue to forest green */
            color: #2e7d32; 
            cursor: pointer;
        }
        .content p {
            color: #444;
            line-height: 1.6;
        }
        a.btn {
            display: inline-block;
            margin-top: 10px;
            /* Changed button background from blue to forest green */
            background-color: #2e7d32; 
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 5px;
            font-size: 14px;
        }
        a.btn:hover {
            /* Changed hover state to a darker shade of green */
            background-color: #1b5e20; 
        }
        footer {
            text-align: center;
            color: #888;
            font-size: 12px;
            margin: 30px 0 10px;
        }
    </style>
</head>
<body>

    <header>
        <h1>SIT Nagpur</h1>
        <p>Department of Computer Science</p>
    </header>

    <div class="content">
        <!-- INLINE JS -->
        <h2 onclick="console.log('Inline JS: Department title clicked!')">
            Welcome to our Department Page
        </h2>
        <p>Click the heading above to see an inline JS console message. This page also links to the student information page below.</p>
        <a class="btn" href="student.html">View Student Information</a>
    </div>

    <footer>Made by a Student &middot; SIT Nagpur</footer>

    <script>
        // INTERNAL JS
        console.log("Internal JS: Department page loaded successfully.");
    </script>
    <!-- EXTERNAL JS -->
    <script src="script.js"></script>

</body>
</html>
