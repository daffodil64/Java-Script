
<!DOCTYPE html>
<html>
<head>
    <title>Scholarship Eligibility</title>
    <style>
        body {
            /* Changed background from default grey to soft light green */
            background-color: #f0f7f4; 
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 40px;
        }
        h2 {
            /* Changed headers to forest green */
            color: #2e7d32; 
            margin: 5px 0;
        }
        h3 {
            color: #333;
            margin-top: 15px;
        }
        input {
            padding: 8px;
            font-size: 15px;
            margin-top: 10px;
            /* Swapped yellowish border out for an elegant dark green border */
            border: 1px solid #2e7d32; 
            border-radius: 4px;
            text-align: center;
            outline: none;
        }
        button {
            display: block;
            margin: 15px auto 0;
            padding: 8px 20px;
            font-size: 15px;
            /* Changed button to forest green */
            background-color: #2e7d32; 
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        button:hover {
            /* Darker green on hover */
            background-color: #1b5e20; 
        }
        #result {
            margin: 20px auto 0;
            padding: 15px;
            max-width: 300px;
            font-size: 17px;
            color: #333;
            /* Added a clean light green card background for results */
            background-color: #e8f5e9; 
            border-left: 5px solid #2e7d32;
            border-radius: 4px;
            line-height: 1.6;
        }
    </style>
</head>
<body>

    <h2>Piyush Chopade 2507051509</h2>
    <h2>Scholarship Eligibility System</h2>
    
    <h3>Enter marks:</h3>
    <input type='number' id='marks' min='0' max='100' placeholder='0 - 100'></input>
    <button onClick="checkScholarship()">Submit</button>
    
    <p id='result'></p>

    <script>
        function checkScholarship(){
            var marks = document.getElementById("marks").value;
            
            if( marks == ""){
                alert("Please Enter marks!!");
                return;
            }
            
            if(marks < 0 || marks > 100){
                alert("Enter marks between 0 and 100");
                return;
            }
            
            var scholarship; // Declared explicitly for cleaner practice
            
            if(marks >= 95){
                scholarship = "Platinum Scholarship 🏆";
            } 
            else if(marks >= 85){
                scholarship = "Gold Scholarship 🥇";
            } 
            else if(marks >= 70){
                scholarship = "Silver Scholarship 🥈";
            } 
            else if(marks >= 50){
                scholarship = "Bronze Scholarship 🥉";
            } 
            else{
                scholarship = "Not Eligible ❌";
            }
            
            document.getElementById("result").innerHTML = "<strong>Marks:</strong> " + marks + "<br><strong>Status:</strong> " + scholarship;
        }
    </script>
</body>
</html>
